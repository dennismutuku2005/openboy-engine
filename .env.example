# ==============================================================================
# OpenBoy Engine Environment Secrets & Database Configuration
# ==============================================================================

# Server Network Port
SERVER_PORT=4040

# Concurrency Worker Pool (parallel probe workers)
WORKER_COUNT=15

# Persistent Local Snapshot Directory
DATA_DIR=./data

# ------------------------------------------------------------------------------
# MySQL Database Connection Credentials
# ------------------------------------------------------------------------------
# Hostname or IP of the MySQL server (e.g. 127.0.0.1, localhost, or remote IP)
DB_HOST=127.0.0.1

# MySQL Port (default 3306)
DB_PORT=3306

# MySQL Username
DB_USER=root

# MySQL Password (leave blank if root has no password)
DB_PASSWORD=

# MySQL Database Name
DB_NAME=openboy

# Optional Raw MySQL DSN override (if set, overrides individual DB_* settings above)
# MYSQL_DSN=root:secret@tcp(127.0.0.1:3306)/openboy?parseTime=true&charset=utf8mb4

# ------------------------------------------------------------------------------
# JWT Authentication Secret
# ------------------------------------------------------------------------------
JWT_SECRET=openboy-super-secret-jwt-signing-key-2026
